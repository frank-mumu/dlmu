# 共享数据库（契约中枢）。开发用 sqlite，生产可换 postgresql://user:pass@host:5432/dlmu
DATABASE_URL=sqlite:///dlmu.db

# 创作 Agent 使用的大模型（OpenAI 兼容，接你已有模型网关）。
# 留空则创作走“模板占位”，采集→存储→选题→创作 全链路仍可跑通，只是文案非 AI 生成。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 输出目录（草稿、图文卡片）
OUTPUT_DIR=./outputs

# 图文卡片中文字体路径（留空自动探测；Linux 服务器需指定一个 CJK 字体）
CARD_FONT=

# 目标学校池（逗号分隔），用于“学校定向”选题/主题
DEFAULT_POOL=大连海事大学

# 全网搜索 API（可选）。留空则 fetch-all 跳过搜索；
# 此时「全网抓取」由定时任务里的 Agent 用内置 WebSearch 完成并 ingest-web 入库。
# 约定：GET {SEARCH_API_URL}?q=<query>，可选 Bearer key，返回 JSON(results/items/data 数组)。
SEARCH_API_URL=
SEARCH_API_KEY=

# ── 语音解说（配图配音，发布配乐）──────────────────────────────
# 提供方：say=macOS 系统音(默认,零成本,偏机械) | elevenlabs=自然/可克隆(需 key)
TTS_PROVIDER=say
# 系统音音色/语速（TTS_PROVIDER=say 时生效）：Tingting(大陆女声)/Flo/Sandy/Meijia；语速默认 205
TTS_VOICE=Tingting
TTS_RATE=205
# ElevenLabs：填 key 后可用 clone-voice 克隆你自己的音色，自然、有感情、支持中文
ELEVENLABS_API_KEY=
# 克隆/选定的音色 id（clone-voice --save 会自动写入）
ELEVENLABS_VOICE_ID=
